{
  "name": "chisel",
  "version": "1.0.0",
  "description": "Chisel \u2014 Lookmax AI Facial Assistant",
  "main": "www/index.html",
  "scripts": {
    "build": "node scripts/verify-build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:enhancements": "node --test tests/enhancements-core.test.cjs tests/enhancements-ui.test.cjs tests/native-integration.test.cjs",
    "test:precision": "node --test tests/precision-core.test.cjs tests/precision-ui.test.cjs tests/precision-native.test.cjs",
    "test:premium": "node --test tests/premium-ux.test.cjs",
    "sync": "cap sync android",
    "open": "cap open android",
    "android": "cap run android",
    "serve": "npx http-server www -p 8080 -c-1",
    "pretest": "cap sync android"
  },
  "keywords": [
    "lookmax",
    "facial",
    "ai",
    "capacitor",
    "android",
    "affirmations"
  ],
  "author": "Chisel",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "7.6.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@revenuecat/purchases-capacitor": "11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
