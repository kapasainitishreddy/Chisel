{
  "name": "chisel",
  "version": "1.0.0",
  "description": "Chisel \u2014 Lookmax AI Facial Assistant",
  "main": "www/index.html",
  "scripts": {
    "build": "node scripts/verify-build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser-local-lifecycle.test.cjs tests/archive-recovery-browser.test.cjs tests/looks-gallery-browser.test.cjs",
    "test:enhancements": "node --test tests/enhancements-core.test.cjs tests/enhancements-ui.test.cjs tests/native-integration.test.cjs",
    "test:precision": "node --test tests/precision-core.test.cjs tests/precision-ui.test.cjs tests/precision-native.test.cjs",
    "test:premium": "node --test tests/premium-ux.test.cjs",
    "sync": "cap sync android",
    "open": "cap open android",
    "android": "cap run android",
    "serve": "npx http-server www -p 8080 -c-1",
    "pretest": "cap sync android"
  },
  "keywords": [
    "lookmax",
    "facial",
    "ai",
    "capacitor",
    "android",
    "affirmations"
  ],
  "author": "Chisel",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/camera": "6.0.2",
    "@capacitor/core": "6.1.2",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "6.1.0",
    "@capacitor/splash-screen": "6.0.2",
    "@capacitor/status-bar": "6.0.2",
    "@revenuecat/purchases-capacitor": "9.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.1.2",
    "playwright": "^1.64.1"
  }
}
