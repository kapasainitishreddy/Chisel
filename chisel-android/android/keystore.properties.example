# Copy this file to `keystore.properties` (same folder) and fill in YOUR values.
# `keystore.properties` is gitignored — it never gets committed. Never share it.
#
# storeFile is resolved relative to the android/ folder, so if you put
# chisel-upload.jks in chisel-android/android/, just use the filename below.

storeFile=chisel-upload.jks
storePassword=CHANGE_ME_store_password
keyAlias=chisel
keyPassword=CHANGE_ME_key_password
